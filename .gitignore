# Only application source and public project files belong in this repository.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/CHANGELOG.md
!/CONTRIBUTING.md
!/SECURITY.md
!/LICENSE
!/Package.swift
!/.github/
!/.githooks/
!/Examples/
!/Prompts/
!/Resources/
!/Sources/
!/Tests/
!/cloud/
!/docs/
!/mcp/
!/plugins/
!/scripts/

# Generated output, dependencies and local machine configuration.
**/.DS_Store
**/node_modules/
**/__pycache__/
**/*.pyc
**/.build/
**/.venv/
**/.swiftpm/
**/.supabase/
**/.env
**/.env.*
**/*.xcuserstate
**/*.log
**/*.pem
**/*.p12
**/*.p8
**/*.mobileprovision
**/*.keychain*
**/*.shortcut
**/runtime.sh
mcp/client-config.json

# Financial data, cloud state, backups and private diagnostics.
**/ledger.json*
**/cloud-settings.json
**/cloud-checkpoint.json
**/notification-history.json
**/cloud-project.json
**/MoraCloud.json
**/mcp-http-token
**/mcp-app-*.json
**/Mora-backup-*
**/before-cloud-*.json
**/*.backup
cloud/VERIFICATION.md
docs/localization-and-navigation.md
docs/scrolling-regression.md
